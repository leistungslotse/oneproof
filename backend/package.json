{
  "name": "noots-mock",
  "version": "0.1.0",
  "description": "Mock of an evidence retrieval via the NOOTS: SAK-DC Consumer API v3 and a JSON facade in the shape of the DCA",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=data src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.37",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "yaml": "^2.9.1"
  }
}
