# Access to the AI service of IONOS (AI Model Hub). Copy this file to `.env` and fill it in.
# The token stays on the server: the page only talks to /ionos/…, the server adds the token.

# Required for reading evidence: the API token of the IONOS AI Model Hub.
IONOS_API_TOKEN=

# Optional: where the NOOTS mock listens (`npm run backend`). The page asks it under /noots/….
# NOOTS_URL=http://127.0.0.1:8787

# Optional: the endpoint, if it is not the one in Berlin.
# IONOS_ENDPOINT=https://openai.inference.de-txl.ionos.com
